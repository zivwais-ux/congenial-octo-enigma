# ─────────────────────────────────────────────────────────────────────────────
# Street Eats Asia — environment variables
# Copy this file to `.env` and fill in your own values.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle.
# Everything else is used at build time only (e.g. native map API keys).
# ─────────────────────────────────────────────────────────────────────────────

# Which data backend to use at runtime.
#   local    -> offline seed data + on-device AsyncStorage (default, no setup)
#   supabase -> Supabase Postgres + Auth + Storage (see docs/SETUP.md)
EXPO_PUBLIC_DATA_BACKEND=local

# ── Supabase (only required when EXPO_PUBLIC_DATA_BACKEND=supabase) ──────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Maps ─────────────────────────────────────────────────────────────
# Native map rendering (react-native-maps). Create keys in Google Cloud Console
# and restrict them to the iOS bundle id / Android package name + SHA-1.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: key used by the web map fallback (static/embedded map preview).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# ── Monitoring (optional) ───────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
